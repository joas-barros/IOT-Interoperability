<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} [%-5level] [%-25logger{25}] %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/gateway-iot.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/gateway-iot.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="STDOUT_COAP" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Tudo que estiver dentro de %cyan(...) ficará colorido -->
            <pattern>%cyan(%d{HH:mm:ss.SSS} [CoAP] %-5level %logger{20} - %msg)%n</pattern>
        </encoder>
    </appender>

    <appender name="STDOUT_MQTT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%magenta(%d{HH:mm:ss.SSS} [MQTT] %-5level %logger{20} - %msg)%n</pattern>
        </encoder>
    </appender>

    <appender name="STDOUT_METRICS" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%boldGreen(=== %d{HH:mm:ss} [METRICS] %msg ===)%n</pattern>
        </encoder>
    </appender>

    <!-- Reduz verbosidade do Californium -->
    <logger name="org.eclipse.californium" level="WARN"/>
    <logger name="org.eclipse.paho"         level="WARN"/>

    <!-- Nosso código em DEBUG -->
    <logger name="coap" level="INFO" additivity="false">
        <appender-ref ref="STDOUT_COAP" />
        <appender-ref ref="FILE" />
    </logger>

    <!-- Todo log gerado pelas classes no pacote 'mqtt' vai para o appender Magenta -->
    <logger name="mqtt" level="INFO" additivity="false">
        <appender-ref ref="STDOUT_MQTT" />
        <appender-ref ref="FILE" />
    </logger>

    <!-- Logger exclusivo nomeado manualmente para métricas -->
    <logger name="SystemMetrics" level="INFO" additivity="false">
        <appender-ref ref="STDOUT_METRICS" />
        <appender-ref ref="FILE" />
    </logger>

    <logger name="forwarder" level="DEBUG"/>
    <logger name="pipeline" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>